# Copy to backend/.env and replace placeholders locally. Never commit .env.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/Nexora
# Optional comma-separated DNS resolver IPs if Node SRV resolution fails (e.g. 192.168.1.1)
# MONGODB_DNS_SERVERS=192.168.1.1
JWT_SECRET=<generate-a-long-random-secret>
CORS_ORIGINS=http://localhost:3000
HF_TOKEN=<your-hugging-face-token>
HF_MODEL=Qwen/Qwen3.8-27B:novita
